<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TailwindExe>$(MSBuildProjectDirectory)\..\..\tools\tailwindcss.exe</TailwindExe>
    <UserSecretsId>fe173823-574a-43ce-955e-ff7fed1ecaa3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FuzzySharp" Version="2.0.2" />
  </ItemGroup>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Condition="Exists('$(TailwindExe)')">
    <Message Importance="high" Text="Building Tailwind CSS..." />
    <Exec Command="&quot;$(TailwindExe)&quot; --input Styles/app.css --output wwwroot/css/app.css --minify" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="WarnMissingTailwind" BeforeTargets="BeforeBuild" Condition="!Exists('$(TailwindExe)')">
    <Warning Text="Tailwind CLI not found at $(TailwindExe). Run tools/get-tailwind.ps1 - see README." />
  </Target>

</Project>
