{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Groq": {
    "ApiKey": "",
    "BaseUrl": "https://api.groq.com/openai/v1",
    "TranscriptionModel": "whisper-large-v3",
    "CrossCheckModel": "whisper-large-v3",
    "PrimaryTemperature": 0.0,
    "CrossCheckTemperature": 0.4,
    "ExtractionModel": "openai/gpt-oss-120b",
    "Language": "bn",
    "EnableCrossCheck": true,
    "TimeoutSeconds": 30
  },

  "Confidence": {
    "AvgLogprobFloor": -0.5,
    "NoSpeechProbCeiling": 0.4,
    "CompressionRatioMax": 2.2,
    "CompressionRatioMin": 0.85,
    "ContactMatchThreshold": 70,
    "ContactMatchConfidentThreshold": 85,
    "ExposeDiagnostics": false
  }
}
