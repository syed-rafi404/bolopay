@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — BoloPay</title>
    <meta name="description" content="An independent portfolio prototype exploring voice-based transaction safety for Bangla speech." />
    <meta name="robots" content="noindex" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="h-full bg-slate-100 text-slate-900 antialiased">
    @RenderBody()

    <script src="~/js/recorder.js" asp-append-version="true"></script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    @* Alpine is vendored rather than CDN-loaded: one less third-party
       dependency between a recruiter and a working demo. *@
    <script defer src="~/js/alpine.min.js" asp-append-version="true"></script>
</body>
</html>
